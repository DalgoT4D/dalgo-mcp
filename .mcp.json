{
  "dalgo": {
    "command": "uv",
    "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "dalgo-mcp"],
    "env": {
      "DALGO_API_URL": "${user_config.dalgo_api_url}",
      "DALGO_USERNAME": "${user_config.dalgo_username}",
      "DALGO_PASSWORD": "${user_config.dalgo_password}",
      "DALGO_ORG_SLUG": "${user_config.dalgo_org_slug}"
    }
  }
}
