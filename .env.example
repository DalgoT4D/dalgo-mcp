DALGO_API_URL=http://localhost:8002
DALGO_USERNAME=your-email@example.com
DALGO_PASSWORD=your-password
DALGO_ORG_SLUG=your-org-slug

# Transport: "stdio" (default, for Claude Desktop/Code) or "streamable-http" (for Anthropic MCP connector)
DALGO_TRANSPORT=stdio
# Host and port for streamable-http transport (ignored in stdio mode)
DALGO_HOST=0.0.0.0
DALGO_PORT=8080
